/* PauseMenu.uss */

/* Полупрозрачный фон на весь экран */
.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.85);
}

/* Панель меню */
.menu-panel {
    width: 400px;
    padding: 40px;
    background-color: rgb(45, 45, 55);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(70, 70, 90);
}

/* Кнопки */
Button {
    height: 50px;
    margin-bottom: 15px;
    font-size: 20px;
    color: white;
    background-color: rgb(70, 70, 80);
    border-radius: 8px;
    border-width: 0;
    -unity-font-style: bold;
}

Button:hover {
    background-color: rgb(90, 90, 100);
}

/* Кнопка "Продолжить" - акцентная */
#resume-button {
    background-color: rgb(50, 120, 60);
    height: 60px; /* Чуть больше остальных */
    font-size: 22px;
    margin-bottom: 25px;
}

#resume-button:hover {
    background-color: rgb(60, 150, 70);
}

/* Кнопка "Выход" */
#quit-button {
    background-color: rgb(120, 50, 50);
    margin-top: 10px;
}

#quit-button:hover {
    background-color: rgb(150, 60, 60);
}

/* Фон для контейнера */
#container {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    padding: 20px;
}
