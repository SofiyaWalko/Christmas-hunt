/* PauseMenu.uss */

/* Фон на весь экран */
.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(10, 10, 20);
}

/* Панель меню */
.menu-panel {
    width: 400px;
    padding: 40px;
    background-color: rgb(30, 30, 40);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(50, 50, 60);
}

/* Кнопки */
Button {
    height: 50px;
    margin-bottom: 15px;
    font-size: 20px;
    color: white;
    background-color: rgb(28, 40, 68); /* dark blue */
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(99, 102, 241); /* purple-blue */
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

Button:hover {
    background-color: rgb(99, 102, 241); /* bright purple */
    border-color: rgb(129, 140, 255);
}

/* Кнопка "Продолжить" - акцентная */
#resume-button {
    background-color: rgb(59, 130, 246); /* blue accent */
    height: 60px;
    font-size: 22px;
    margin-bottom: 25px;
    border-color: rgb(99, 179, 255);
}

#resume-button:hover {
    background-color: rgb(60, 150, 70);
}

/* Кнопка "Выход" */
/* Keep quit button red */
#quit-button {
    background-color: rgb(140, 50, 50);
    margin-top: 10px;
    border-color: rgb(160, 70, 70);
}

#quit-button:hover {
    background-color: rgb(170, 60, 60);
}

/* Фон для контейнера */
#container {
    background-color: rgb(20, 20, 30);
    border-radius: 10px;
    padding: 20px;
}

/* overlay class for submenus opened from pause to hide background */
.load-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(12,12,18);
    z-index: 20;
}
