/* === INK ДИАЛОГ === */
.ink-dialogue-box {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgb(25, 25, 35);
    padding: 25px;
    border-radius: 20px;
    border: 2px solid rgb(50, 50, 60);
    flex-direction: column;
    align-items: center;
    width: 850px;
    display: none;
    max-height: 400px;
    overflow-y: auto;
}

.ink-character-name {
    font-size: 26px;
    color: rgb(251, 191, 36);
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.ink-sentence-text {
    font-size: 20px;
    color: white;
    text-align: center;
    margin-bottom: 20px;
    line-height: 1.4;
}

.ink-choices-container {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
}

.ink-choice-button {
    background-color: rgb(66, 153, 225);
    color: white;
    font-size: 16px;
    padding: 12px 24px;
    border-radius: 12px;
    -unity-font-style: bold;
    border: 2px solid rgb(100, 180, 255);
    text-align: center;
    width: 300px;
    transition-duration: 0.2s;
}

.ink-choice-button:hover {
    background-color: rgb(49, 130, 206);
    border-color: rgb(120, 200, 255);
}

.ink-continue-button {
    background-color: rgb(114, 51, 255);
    color: white;
    font-size: 18px;
    padding: 12px 30px;
    border-radius: 12px;
    -unity-font-style: bold;
    border: 2px solid rgb(160, 120, 255);
    transition-duration: 0.2s;
}

.ink-continue-button:hover {
    background-color: rgb(92, 36, 204);
    border-color: rgb(180, 150, 255);
}