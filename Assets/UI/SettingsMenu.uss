/* SettingsMenu.uss */

/* Фон */
.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(20, 20, 30);
}

/* Панель настроек */
.settings-panel {
    width: 600px;
    padding: 40px;
    background-color: rgb(30, 30, 40);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(50, 50, 60);
}

/* Общий стиль полей (слайдеры, дропдауны) */
.unity-base-field {
    margin-bottom: 25px;
    justify-content: space-between;
}

/* Лейблы полей */
.unity-base-field__label {
    font-size: 20px;
    color: rgb(251, 191, 36); /* yellow */
    min-width: 200px;
    -unity-font-style: bold;
}

/* Слайдер громкости */
#volume-slider .unity-base-slider__tracker {
    background-color: rgb(59, 130, 246); /* blue track */
    height: 6px;
    border-radius: 3px;
}

#volume-slider .unity-base-slider__dragger {
    background-color: rgb(99, 179, 255); /* lighter blue */
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 0;
    margin-top: -9px;
    transition-duration: 0.2s;
}

#volume-slider .unity-base-slider__dragger:hover {
    background-color: rgb(139, 92, 246); /* purple on hover */
    scale: 1.1;
}

/* Выпадающий список */
#quality-dropdown .unity-base-field__input {
    background-color: rgb(50, 50, 60);
    border-width: 2px;
    border-color: rgb(80, 80, 90);
    border-radius: 10px;
    padding: 5px;
    color: white;
    font-size: 16px;
}

/* Кнопка "Назад" */
#back-button {
    margin-top: 40px;
    height: 50px;
    width: 200px;
    align-self: center;
    font-size: 18px;
    background-color: rgb(59, 130, 246); /* blue */
    color: white;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(99, 179, 255);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

#back-button:hover {
    background-color: rgb(139, 92, 246); /* purple */
    border-color: rgb(170, 140, 255);
}

/* Фон для контейнера */
#container {
    background-color: rgb(25, 25, 35);
    border-radius: 10px;
    padding: 20px;
}
