/* Notification modal styles */
.modal-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  justify-content: center;
  align-items: center;
  display: none; /* hidden by default */
  z-index: 1000;
}

.modal-overlay.show {
  display: flex;
}

.modal-window {
  width: 520px;
  max-width: 90%;
  background-color: rgb(255, 255, 255);
  border-radius: 12px;
  padding: 18px 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.modal-title {
  font-size: 20px;
  font-weight: 700;
  color: rgb(20, 24, 28);
}

.modal-message {
  font-size: 16px;
  color: rgb(40, 44, 48);
  white-space: pre-wrap;
}

.modal-actions {
  align-self: flex-end;
  display: flex;
  gap: 8px;
}

.modal-button {
  background-color: rgb(70,130,180);
  color: white;
  padding: 8px 14px;
  border-radius: 6px;
  border: none;
  font-size: 14px;
}

.modal-button.secondary {
  background-color: rgb(200, 200, 200);
  color: rgb(20,20,20);
}
